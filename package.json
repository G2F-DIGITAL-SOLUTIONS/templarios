{
  "name": "templarios",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional da Ordem Internacional Civil Militar Cavaleiros Templários do Brasil (OICMCTB).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "prebuild": "npm run redirects",
    "preview": "astro preview",
    "check": "astro check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "redirects": "node scripts/generate-redirects.mjs",
    "verify": "npm run check && npm run check:i18n && npm run build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
