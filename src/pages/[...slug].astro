---
import type { GetStaticPaths } from 'astro';
import HomeView from '@/views/HomeView.astro';
import OrderPage from '@/views/OrderPage.astro';
import HeritagePage from '@/views/HeritagePage.astro';
import SocietyPage from '@/views/SocietyPage.astro';
import ParticipatePage from '@/views/ParticipatePage.astro';
import LegalPage from '@/views/LegalPage.astro';
import NotFoundPage from '@/views/NotFoundPage.astro';
import { routeDefinitions, type RouteDefinition } from '@/routes';
import { locales, type Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath } from '@/i18n/routes';

/**
 * Single dynamic route that statically generates every page for every locale.
 *
 * Static output, one file per (locale, route) pair — ideal for a CDN and for
 * Lighthouse. Pages stay thin because all rendering lives in `src/views`.
 */
export const getStaticPaths: GetStaticPaths = () => {
  return locales.flatMap((locale) =>
    routeDefinitions.map((definition) => ({
      params: { slug: localizedPath(locale, definition.routeKey).replace(/^\//, '') || undefined },
      props: { locale, definition },
    })),
  );
};

interface Props {
  locale: Locale;
  definition: RouteDefinition;
}

const { locale, definition } = Astro.props;
const { routeKey, view, meta } = definition;
const dict = getDictionary(locale);

const legal = meta?.legal ? dict.legal[meta.legal] : undefined;
const legalPage = meta?.legal ? dict.pages[meta.legal] : undefined;
---

{
  view === 'home' && <HomeView locale={locale} />
}

{view === 'order' && <OrderPage locale={locale} />}

{view === 'heritage' && <HeritagePage locale={locale} />}

{view === 'society' && <SocietyPage locale={locale} />}

{view === 'participate' && <ParticipatePage locale={locale} />}

{
  view === 'legal' && legal && legalPage && (
    <LegalPage
      locale={locale}
      routeKey={routeKey}
      title={legalPage.title}
      description={legalPage.lead}
      paragraphs={legal.paragraphs}
    />
  )
}

{view === 'notFound' && <NotFoundPage locale={locale} />}
