---
import Icon from '@/components/ui/Icon.astro';
import { formatDate } from '@/utils/date';
import type { Locale } from '@/i18n/config';

/**
 * EventCard — a compact agenda entry. Renders a date block, title, venue and
 * an optional link to the external events platform.
 */
interface Props {
  locale: Locale;
  title: string;
  summary: string;
  date: string;
  location: string;
  url?: string;
  dateLabel: string;
  locationLabel: string;
  cta: string;
  externalNote?: string;
}

const {
  locale,
  title,
  summary,
  date,
  location,
  url,
  dateLabel,
  locationLabel,
  cta,
  externalNote,
} = Astro.props;

const accessibleDate = formatDate(date, locale);
const isExternal = Boolean(url);
---

<li class="card group flex h-full flex-col p-6">
  <div class="flex items-start gap-5">
    <div
      class="flex shrink-0 flex-col items-center rounded-sm border border-gold-500/40 bg-parchment-dark/50 px-3 py-2 text-center"
      aria-hidden="true"
    >
      <span class="font-display text-2xl font-semibold leading-none text-wine-700">
        {new Date(`${date}T12:00:00`).getDate().toString().padStart(2, '0')}
      </span>
      <span class="mt-1 text-[0.62rem] font-semibold tracking-widest text-stone-500 uppercase">
        {new Intl.DateTimeFormat(locale === 'pt' ? 'pt-BR' : locale, { month: 'short' })
          .format(new Date(`${date}T12:00:00`))
          .replace('.', '')}
      </span>
    </div>

    <div class="flex-1">
      <p class="sr-only">
        {dateLabel}: <time datetime={date}>{accessibleDate}</time>
      </p>
      <h3 class="font-display text-lg font-semibold text-ink-900">{title}</h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-600">{summary}</p>
      <p class="mt-4 flex items-center gap-2 text-xs text-stone-500">
        <Icon name="map-pin" size={15} class="text-gold-600" />
        <span class="sr-only">{locationLabel}: </span>{location}
      </p>
    </div>
  </div>

  {
    url && (
      <div class="mt-5 border-t border-stone-200/80 pt-4">
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="link-quiet inline-flex items-center gap-2 text-sm"
        >
          {cta}
          <Icon name="arrow-up-right" size={15} />
        </a>
        {externalNote && <p class="mt-2 text-xs text-stone-400">{externalNote}</p>}
      </div>
    )
  }
  {
    isExternal && (
      <span class="sr-only">{externalNote}</span>
    )
  }
</li>