---
import Emblem from '@/components/ui/Emblem.astro';
import Icon from '@/components/ui/Icon.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { primaryNav, secondaryNav } from '@/config/navigation';
import { localizedPath, type Locale } from '@/i18n';
import type { Dictionary } from '@/i18n/dictionaries';
import type { RouteKey } from '@/i18n/routes';

interface Props {
  locale: Locale;
  dict: Dictionary;
  currentPath: string;
  /** The route of the current page, so the language switcher stays on it. */
  routeKey: RouteKey;
}

const { locale, dict, currentPath, routeKey } = Astro.props;

/** A path is "current" if it matches, or is a prefix (for nested routes). */
function isCurrent(path: string): boolean {
  const normalised = currentPath.replace(/\/$/, '') || '/';
  const target = path.replace(/\/$/, '') || '/';
  if (target === '/') return normalised === '/';
  return normalised === target || normalised.startsWith(`${target}/`);
}

const homeHref = localizedPath(locale, 'home');
const orderHref = localizedPath(locale, 'order');
const participateHref = localizedPath(locale, 'participate');
---

<a class="skip-link" href="#conteudo">{dict.common.skipToContent}</a>

<header
  class="sticky top-0 z-50 border-b border-stone-200/80 bg-parchment/90 backdrop-blur supports-[backdrop-filter]:bg-parchment/75"
>
  <!-- Masthead: brand, language and primary action -->
  <div class="container-templar">
    <div class="flex h-[var(--header-top-height)] items-center justify-between gap-4">
      <!-- Brand -->
      <a
        href={homeHref}
        class="group flex min-w-0 flex-1 items-center gap-3 no-underline"
        aria-label={`${dict.meta.shortName} — ${dict.meta.siteName}`}
      >
        <span
          class="shrink-0 text-wine-700 transition-colors group-hover:text-gold-600"
          aria-hidden="true"
        >
          <Emblem size={38} />
        </span>
        <span class="flex min-w-0 flex-col leading-none">
          <span class="block truncate font-display text-sm font-semibold tracking-wide text-ink-900 lg:text-[0.82rem] xl:text-[0.95rem]">
            <span class="hidden lg:inline">{dict.meta.siteName}</span>
            <span class="lg:hidden">{dict.meta.shortName}</span>
          </span>
          <span class="mt-1 hidden text-[0.62rem] font-medium tracking-[0.2em] text-stone-500 uppercase lg:block">
            {dict.meta.shortName}
          </span>
        </span>
      </a>

      <!-- Utilities -->
      <div class="flex shrink-0 items-center gap-2 xl:gap-4">
        <LanguageSwitcher
          locale={locale}
          routeKey={routeKey}
          label={dict.language.label}
          switchToLabel={dict.language.switchTo}
          class="hidden md:block"
          variant="bar"
        />
        <a
          href={orderHref}
          class="btn btn-primary hidden whitespace-nowrap !min-h-11 !px-4 !py-2.5 !text-[0.72rem] lg:!px-4 xl:!px-6 lg:inline-flex"
        >
          {dict.nav.ctaPrimary}
        </a>

        <!-- Mobile menu toggle -->
        <button
          type="button"
          id="menu-toggle"
          class="inline-flex size-11 items-center justify-center rounded-sm border border-stone-300 text-ink-800 transition-colors hover:border-gold-500 hover:text-wine-700 lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={dict.nav.openMenu}
          data-open-label={dict.nav.openMenu}
          data-close-label={dict.nav.closeMenu}
        >
          <Icon name="menu" size={22} class="menu-icon-open" />
          <Icon name="close" size={22} class="menu-icon-close hidden" />
        </button>
      </div>
    </div>
  </div>

  <!-- Desktop navigation: its own row keeps long institutional names and
       long localised labels from competing for the same horizontal space. -->
  <div class="hidden border-t border-stone-200/70 lg:block">
    <div class="container-templar">
      <nav aria-label={dict.nav.label}>
        <ul class="flex h-[var(--header-nav-height)] items-center justify-center gap-1">
          {
            primaryNav.map((item) => {
              const href = localizedPath(locale, item.routeKey);
              const active = isCurrent(href);
              return (
                <li class="h-full">
                  <a
                    href={href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'inline-flex h-full items-center whitespace-nowrap border-b-2 px-3 text-[0.82rem] font-medium no-underline transition-colors xl:px-5 xl:text-sm',
                      active
                        ? 'border-gold-500 text-wine-700'
                        : 'border-transparent text-ink-700 hover:border-gold-500/40 hover:text-wine-700',
                    ]}
                  >
                    {dict.nav[item.labelKey]}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden" data-mobile-menu>
    <div class="border-t border-stone-200 bg-surface-raised">
      <nav class="container-templar max-h-[calc(100dvh-var(--header-height))] overflow-y-auto py-4" aria-label={dict.nav.label}>
        <ul class="flex flex-col">
          {
            primaryNav.map((item) => {
              const href = localizedPath(locale, item.routeKey);
              return (
                <li class="border-b border-stone-200/70">
                  <a
                    href={href}
                    aria-current={isCurrent(href) ? 'page' : undefined}
                    class="flex min-h-12 items-center text-base font-medium text-ink-800 no-underline"
                  >
                    {dict.nav[item.labelKey]}
                  </a>
                </li>
              );
            })
          }
          {
            secondaryNav
              .filter((item) => item.routeKey !== 'participate')
              .map((item) => {
                const href = localizedPath(locale, item.routeKey);
                return (
                  <li class="border-b border-stone-200/70">
                    <a
                      href={href}
                      aria-current={isCurrent(href) ? 'page' : undefined}
                      class="flex min-h-12 items-center text-base font-medium text-ink-800 no-underline"
                    >
                      {dict.nav[item.labelKey]}
                    </a>
                  </li>
                );
              })
          }
        </ul>

        <div class="mt-5 flex flex-col gap-3">
          <a href={orderHref} class="btn btn-primary w-full">{dict.nav.ctaPrimary}</a>
          <a href={participateHref} class="btn btn-outline w-full">{dict.nav.ctaSecondary}</a>
          <div class="flex items-center justify-between border-t border-stone-200 pt-4">
            <span class="text-xs font-semibold tracking-widest text-stone-500 uppercase">
              {dict.language.label}
            </span>
            <LanguageSwitcher
              locale={locale}
              routeKey={routeKey}
              label={dict.language.label}
              switchToLabel={dict.language.switchTo}
              variant="inline"
            />
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  // Click-driven dropdowns (language selector).
  // Generic: any [data-dropdown] with a [data-dropdown-toggle] child works.
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('[data-dropdown]'));

  const setOpen = (container: HTMLElement, open: boolean) => {
    container.dataset.open = String(open);
    container.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', String(open));
  };

  const closeAll = (except?: HTMLElement) => {
    for (const dropdown of dropdowns) {
      if (dropdown !== except) setOpen(dropdown, false);
    }
  };

  for (const container of dropdowns) {
    const toggle = container.querySelector<HTMLElement>('[data-dropdown-toggle]');
    if (!toggle) continue;

    toggle.addEventListener('click', (event) => {
      event.preventDefault();
      const willOpen = container.dataset.open !== 'true';
      closeAll(container);
      setOpen(container, willOpen);
    });
  }

  // Close on outside click, on Escape, and when a menu link is chosen.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (!target.closest('[data-dropdown]')) closeAll();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = dropdowns.find((dropdown) => dropdown.dataset.open === 'true');
    if (open) {
      setOpen(open, false);
      open.querySelector<HTMLElement>('[data-dropdown-toggle]')?.focus();
    }
  });

  for (const container of dropdowns) {
    container.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(container, false);
    });
  }

  // Minimal, dependency-free mobile menu. Progressive: the menu is usable with
  // no JS for the links themselves; this only handles open/close state.
  const toggle = document.getElementById('menu-toggle');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (toggle && menu) {
    const openIcon = toggle.querySelector('.menu-icon-open');
    const closeIcon = toggle.querySelector('.menu-icon-close');

    const setMenuOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '',
      );
      menu.classList.toggle('hidden', !open);
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => {
      setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close on Escape.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        toggle.focus();
      }
    });

    // Close when a link is chosen.
    menu.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a')) setMenuOpen(false);
    });

    // The drawer only exists below lg. If the viewport grows while it is open,
    // close it so the page scroll lock is released.
    const desktop = window.matchMedia('(min-width: 64rem)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setMenuOpen(false);
    });
  }
</script>
