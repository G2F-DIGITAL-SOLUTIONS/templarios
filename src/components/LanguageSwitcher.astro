---
import { localeNames, localeShort, localeTags, type Locale } from '@/i18n/config';
import { alternatesFor, type RouteKey } from '@/i18n/routes';

/**
 * LanguageSwitcher — a minimal, accessible PT | EN | IT | FR | ES selector.
 *
 * Uses real links (not flags) so it works without JavaScript, is crawlable
 * and lets the browser handle navigation to the equivalent page.
 */
interface Props {
  locale: Locale;
  /** The current route, used to link to the equivalent page in each language. */
  routeKey: RouteKey;
  label: string;
  switchToLabel: string;
  class?: string;
  variant?: 'bar' | 'inline';
}

const {
  locale,
  routeKey,
  label,
  switchToLabel,
  class: className = '',
  variant = 'bar',
} = Astro.props;

const alternates = alternatesFor(routeKey);
---

<nav class={className} aria-label={label}>
  <ul
    class:list={[
      'flex items-center gap-1',
      variant === 'bar' && 'rounded-sm border border-current/20 p-1',
    ]}
  >
    {
      alternates.map((alt) => {
        const isCurrent = alt.locale === locale;
        return (
          <li>
            <a
              href={alt.path}
              lang={localeTags[alt.locale]}
              hreflang={localeTags[alt.locale]}
              aria-current={isCurrent ? 'true' : undefined}
              aria-label={`${switchToLabel}: ${localeNames[alt.locale]}`}
              class:list={[
                'inline-flex min-h-8 min-w-9 items-center justify-center rounded-sm px-2 text-xs font-semibold tracking-wider uppercase no-underline transition-colors',
                isCurrent
                  ? 'text-gold-700'
                  : 'opacity-65 hover:text-gold-700 hover:opacity-100',
              ]}
            >
              {localeShort[alt.locale]}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>