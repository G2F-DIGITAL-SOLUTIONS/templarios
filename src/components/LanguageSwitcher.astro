---
import Icon from '@/components/ui/Icon.astro';
import { localeNames, localeShort, localeTags, type Locale } from '@/i18n/config';
import { alternatesFor, type RouteKey } from '@/i18n/routes';

/**
 * LanguageSwitcher — an accessible language selector.
 *
 *  - `variant="bar"`    → a button that opens a dropdown of languages.
 *  - `variant="inline"` → plain links (used in the mobile menu and footer).
 *
 * Uses real links (not flags) so it works without JavaScript and is crawlable.
 */
interface Props {
  locale: Locale;
  /** The current route, used to link to the equivalent page in each language. */
  routeKey: RouteKey;
  label: string;
  switchToLabel: string;
  class?: string;
  variant?: 'bar' | 'inline';
}

const {
  locale,
  routeKey,
  label,
  switchToLabel,
  class: className = '',
  variant = 'bar',
} = Astro.props;

const alternates = alternatesFor(routeKey);
const menuId = 'language-menu';
---

{
  variant === 'bar' ? (
    <div class:list={['group relative', className]} data-dropdown data-open="false">
      <button
        type="button"
        data-dropdown-toggle
        aria-expanded="false"
        aria-haspopup="true"
        aria-controls={menuId}
        aria-label={`${label}: ${localeShort[locale]}`}
        class="inline-flex min-h-11 items-center gap-2 rounded-sm border border-stone-300/80 px-3 text-xs font-semibold tracking-wider text-ink-700 uppercase transition-colors hover:border-gold-500 hover:text-wine-700"
      >
        <Icon name="globe" size={16} class="text-gold-600" />
        <span>{localeShort[locale]}</span>
        <Icon
          name="chevron-down"
          size={14}
          class="opacity-60 transition-transform duration-200 group-hover:rotate-180 group-data-[open=true]:rotate-180"
        />
      </button>
      <ul
        id={menuId}
        class="invisible absolute right-0 top-full z-20 mt-1 min-w-44 translate-y-1 overflow-hidden rounded-md border border-gold-500/40 bg-surface-raised py-1.5 opacity-0 shadow-[var(--shadow-lift)] transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-data-[open=true]:visible group-data-[open=true]:translate-y-0 group-data-[open=true]:opacity-100"
      >
        {alternates.map((alt) => {
          const isCurrent = alt.locale === locale;
          return (
            <li>
              <a
                href={alt.path}
                lang={localeTags[alt.locale]}
                hreflang={localeTags[alt.locale]}
                aria-current={isCurrent ? 'true' : undefined}
                class:list={[
                  'flex items-center justify-between gap-3 px-4 py-2 text-sm no-underline transition-colors hover:bg-parchment-dark/60 hover:text-wine-700',
                  isCurrent ? 'text-gold-700' : 'text-ink-700',
                ]}
              >
                <span>
                  <span class="sr-only">{switchToLabel}: </span>
                  {localeNames[alt.locale]}
                </span>
                <span class="text-xs font-semibold tracking-wider text-stone-500 uppercase">
                  {localeShort[alt.locale]}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ) : (
    <nav class={className} aria-label={label}>
      <ul class="flex flex-wrap items-center gap-1">
        {alternates.map((alt) => {
          const isCurrent = alt.locale === locale;
          return (
            <li>
              <a
                href={alt.path}
                lang={localeTags[alt.locale]}
                hreflang={localeTags[alt.locale]}
                aria-current={isCurrent ? 'true' : undefined}
                class:list={[
                  'inline-flex min-h-8 min-w-9 items-center justify-center rounded-sm px-2 text-xs font-semibold tracking-wider uppercase no-underline transition-colors',
                  isCurrent ? 'text-gold-700' : 'text-stone-500 hover:text-gold-700',
                ]}
              >
                <span class="sr-only">{switchToLabel}: </span>
                {localeShort[alt.locale]}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}