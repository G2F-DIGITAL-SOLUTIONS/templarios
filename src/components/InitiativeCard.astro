---
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { localizedPath, type Locale } from '@/i18n';

/**
 * InitiativeCard — image-led card for an area of action ("A Ordem em ação").
 */
interface Props {
  locale: Locale;
  title: string;
  text: string;
  icon: IconName;
  routeKey: Parameters<typeof localizedPath>[1];
  cta: string;
  image?: string;
  imageAlt: string;
}

const { locale, title, text, icon, routeKey, cta, image, imageAlt } = Astro.props;
---

<li class="card group flex h-full flex-col overflow-hidden">
  <a href={localizedPath(locale, routeKey)} class="flex h-full flex-col no-underline">
    <div class="relative aspect-16/10 shrink-0 overflow-hidden bg-ink-900">
      {
        image ? (
          <img
            src={image}
            alt={imageAlt}
            width="640"
            height="400"
            loading="lazy"
            decoding="async"
            class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        ) : (
          <div
            class="surface-dark texture-stone grid size-full place-items-center text-gold-400/80"
            aria-hidden="true"
          >
            <Icon name={icon} size={44} strokeWidth={1.25} />
          </div>
        )
      }
      <span
        class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-ink-950/70 to-transparent"
        aria-hidden="true"
      >
      </span>
      <span
        class="absolute bottom-3 left-4 grid size-10 place-items-center rounded-sm border border-gold-400/50 bg-ink-950/70 text-gold-300 backdrop-blur-sm"
        aria-hidden="true"
      >
        <Icon name={icon} size={20} />
      </span>
    </div>

    <div class="flex flex-1 flex-col p-6">
      <h3 class="font-display text-lg font-semibold text-ink-900">{title}</h3>
      <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-600">{text}</p>
      <span class="mt-5 inline-flex items-center gap-2 text-xs font-semibold tracking-[0.14em] text-wine-700 uppercase">
        {cta}
        <Icon name="arrow-right" size={15} class="transition-transform duration-300 group-hover:translate-x-1" />
      </span>
    </div>
  </a>
</li>