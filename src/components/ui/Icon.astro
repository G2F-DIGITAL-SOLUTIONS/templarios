---
/**
 * Icon — a tiny, dependency-free inline SVG set.
 *
 * Keeps the site free of an icon library (less JS, fewer requests) while
 * giving a single, consistent stroke style. Every icon is decorative by
 * default; pass a `title` to expose it to assistive technology.
 */
export type IconName =
  | 'leaf'
  | 'trophy'
  | 'heart-pulse'
  | 'graduation'
  | 'shield'
  | 'scroll'
  | 'compass'
  | 'book'
  | 'hand-heart'
  | 'calendar'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'chevron-down'
  | 'check'
  | 'plus'
  | 'map-pin'
  | 'phone'
  | 'mail'
  | 'globe'
  | 'quote'
  | 'menu'
  | 'close'
  | 'facebook'
  | 'instagram'
  | 'youtube'
  | 'x';

interface Props {
  name: IconName;
  class?: string;
  size?: number | string;
  strokeWidth?: number;
  title?: string;
  filled?: boolean;
}

const {
  name,
  class: className = '',
  size = 24,
  strokeWidth = 1.5,
  title,
  filled = false,
} = Astro.props;

const paths: Record<IconName, string> = {
