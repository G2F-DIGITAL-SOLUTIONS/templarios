---
/**
 * CastleArch — a decorative inline-SVG castle gate (arch, twin towers and
 * lowered drawbridge). Pure vector: crisp, tiny and zero requests.
 *
 * It is intentionally restrained (institutional, not fantasy) and is used as
 * the hero's layered backdrop beneath the optional photograph.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 1440 520"
  preserveAspectRatio="xMidYMax slice"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="castle-tower" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2b2620" />
      <stop offset="1" stop-color="#14110e" />
    </linearGradient>
    <linearGradient id="castle-gate" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0c0a08" />
      <stop offset="1" stop-color="#1e1a16" />
    </linearGradient>
    <radialGradient id="castle-glow" cx="0.5" cy="0" r="0.9">
      <stop offset="0" stop-color="#c9a862" stop-opacity="0.5" />
      <stop offset="1" stop-color="#c9a862" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Warm dawn light behind the keep -->
  <ellipse cx="720" cy="150" rx="520" ry="260" fill="url(#castle-glow)" />

  <!-- Distant wall -->
  <path
    d="M0 360h1440v160H0z"
    fill="url(#castle-tower)"
    opacity="0.55"></path>
  <path
    d="M0 352h120v-18h40v18h120v-18h40v18h120v-18h40v18h120v-18h40v18h120v-18h40v18h120v-18h40v18h120v-18h40v18h80v168H0z"
    fill="url(#castle-tower)"
    opacity="0.35"></path>

  <!-- Left tower -->
  <path d="M150 200h190v320H150z" fill="url(#castle-tower)" />
  <path
    d="M150 200h190l-10-22H160z"
    fill="#1e1a16"></path>
  <g fill="#1e1a16">
    <rect x="150" y="200" width="19" height="14"></rect>
    <rect x="179" y="200" width="19" height="14"></rect>
    <rect x="208" y="200" width="19" height="14"></rect>
    <rect x="237" y="200" width="19" height="14"></rect>
    <rect x="266" y="200" width="19" height="14"></rect>
    <rect x="295" y="200" width="19" height="14"></rect>
    <rect x="321" y="200" width="19" height="14"></rect>
  </g>

  <!-- Right tower -->
  <path d="M1100 200h190v320h-190z" fill="url(#castle-tower)" />
  <path d="M1100 200h190l-10-22h-170z" fill="#1e1a16" />
  <g fill="#1e1a16">
    <rect x="1100" y="200" width="19" height="14"></rect>
    <rect x="1129" y="200" width="19" height="14"></rect>
    <rect x="1158" y="200" width="19" height="14"></rect>
    <rect x="1187" y="200" width="19" height="14"></rect>
    <rect x="1216" y="200" width="19" height="14"></rect>
    <rect x="1245" y="200" width="19" height="14"></rect>
    <rect x="1271" y="200" width="19" height="14"></rect>
  </g>

  <!-- Central keep with gap-toothed battlements -->
  <path d="M520 240h400v300H520z" fill="url(#castle-tower)" />
  <path
    d="M520 240h400l-8-20h-30v14h-40v-14h-40v14h-40v-14h-40v14h-40v-14h-40v14h-40v-14h-40v14h-30z"
    fill="#1e1a16"></path>

  <!-- Round-headed gate -->
  <path
    d="M660 540V430a60 60 0 0 1 120 0v110z"
    fill="url(#castle-gate)"></path>
  <path
    d="M660 540V430a60 60 0 0 1 120 0v110"
    stroke="#8a6d3b"
    stroke-width="2.5"
    opacity="0.7"></path>
  <!-- Portcullis bars -->
  <g stroke="#8a6d3b" stroke-width="1.5" opacity="0.35">
    <line x1="682" y1="392" x2="682" y2="540"></line>
    <line x1="706" y1="378" x2="706" y2="540"></line>
    <line x1="732" y1="378" x2="732" y2="540"></line>
    <line x1="756" y1="392" x2="756" y2="540"></line>
    <line x1="660" y1="430" x2="780" y2="430"></line>
    <line x1="660" y1="472" x2="780" y2="472"></line>
    <line x1="660" y1="514" x2="780" y2="514"></line>
  </g>

  <!-- Lowered drawbridge -->
  <path
    d="M648 540h144l70 40H578z"
    fill="#241f19"
    stroke="#8a6d3b"
    stroke-width="2"
    opacity="0.9"></path>
  <g stroke="#3b342b" stroke-width="2" opacity="0.7">
    <line x1="636" y1="556" x2="806" y2="556"></line>
    <line x1="612" y1="572" x2="830" y2="572"></line>
  </g>
</svg>