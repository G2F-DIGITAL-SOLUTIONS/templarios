---
import { site } from '@/config/site';

/**
 * Emblem — official Signvm Templariorvm Brasiliæ seal.
 *
 * `full` renders the institutional seal introduced on main.
 * `cross` keeps a lightweight Maltese cross for decorative accents only
 * (section headings, cards) so the full seal is not repeated everywhere.
 */
interface Props {
  class?: string;
  size?: number;
  /** 'full' shows the official seal; 'cross' shows only the cross accent. */
  variant?: 'full' | 'cross';
  /**
   * Seal artwork for light or dark surfaces. Defaults to light (dark strokes).
   * Use `dark` on dark surfaces; `header` for the site masthead mark.
   */
  tone?: 'light' | 'dark' | 'header';
  /** Optional accessible name. When omitted the mark is decorative. */
  title?: string;
}

const { class: className = '', size = 48, variant = 'full', tone = 'light', title } = Astro.props;

const sealSrc =
  tone === 'header' ? site.logo.header : tone === 'dark' ? site.logo.dark : site.logo.light;
---

{
  variant === 'full' ? (
    <img
      src={sealSrc}
      width={size}
      height={size}
      alt={title ?? ''}
      class={`block object-contain ${className}`.trim()}
      decoding="async"
      aria-hidden={title ? undefined : 'true'}
    />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 32 32"
      class={className}
      role={title ? 'img' : undefined}
      aria-label={title}
      aria-hidden={title ? undefined : 'true'}
    >
      <g fill="currentColor">
        <path d="M16 3 21 10 16 16 11 10Z" />
        <path d="M29 16 22 11 16 16 22 21Z" />
        <path d="M16 29 11 22 16 16 21 22Z" />
        <path d="M3 16 10 21 16 16 10 11Z" />
      </g>
    </svg>
  )
}
