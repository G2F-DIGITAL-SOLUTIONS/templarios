---
import Icon from '@/components/ui/Icon.astro';
import { formatDate } from '@/utils/date';
import type { Locale } from '@/i18n/config';

/**
 * ArticleCard — editorial card for lectures, studies and articles.
 */
interface Props {
  locale: Locale;
  type: string;
  title: string;
  summary: string;
  date?: string;
  cta: string;
  url?: string;
}

const { locale, type, title, summary, date, cta, url } = Astro.props;
const Tag = url ? 'a' : 'div';
---

<li class="card group flex h-full flex-col p-6">
  <Tag
    {...url ? { href: url, target: '_blank', rel: 'noopener noreferrer' } : {}}
    class="flex flex-1 flex-col no-underline"
  >
    <div class="flex items-center justify-between gap-3">
      <span
        class="inline-flex items-center rounded-sm border border-gold-500/40 px-2.5 py-1 text-[0.66rem] font-semibold tracking-[0.16em] text-gold-700 uppercase"
      >
        {type}
      </span>
      {
        date && (
          <time datetime={date} class="text-xs text-stone-400">
            {formatDate(date, locale)}
          </time>
        )
      }
    </div>

    <h3 class="mt-4 font-display text-lg font-semibold leading-snug text-ink-900">{title}</h3>
    <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-600">{summary}</p>

    <span class="mt-5 inline-flex items-center gap-2 text-xs font-semibold tracking-[0.14em] text-wine-700 uppercase">
      {cta}
      <Icon
        name={url ? 'arrow-up-right' : 'arrow-right'}
        size={15}
        class="transition-transform duration-300 group-hover:translate-x-1"
      />
    </span>
  </Tag>
</li>