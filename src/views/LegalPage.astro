---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';
import type { RouteKey } from '@/i18n/routes';

/**
 * LegalPage — shared renderer for the privacy, terms and cookies pages.
 * The body is intentionally a clear placeholder: the Order must supply the
 * official legal text, and this makes that obligation explicit.
 */
interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  body: string[];
}

const { locale, routeKey, title, body } = Astro.props;
const dict = getDictionary(locale);
const path = localizedPath(locale, routeKey);
const updated = '2026-01-01';
---

<BaseLayout locale={locale} {routeKey} title={title} description={title} path={path} noindex>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={dict.footer.legalTitle}
    title={title}
    crumbs={[{ label: title }]}
  />

  <Section>
    <div class="mx-auto max-w-2xl">
      <p class="flex items-center gap-2 text-sm text-stone-500">
        <Icon name="calendar" size={16} class="text-gold-600" />
        {dict.legal.updatedLabel}:
        <time datetime={updated}>{updated}</time>
      </p>

      <div class="prose-templar mt-8">
        {body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <p class="mt-10 rounded-sm border-l-2 border-gold-500 bg-parchment-dark/40 px-4 py-3 text-sm text-ink-600">
        {dict.legal.placeholderNote}
      </p>

      <a href={localizedPath(locale, 'contact')} class="btn btn-outline mt-8">
        {dict.faq.ctaButton}
      </a>
    </div>
  </Section>
</BaseLayout>