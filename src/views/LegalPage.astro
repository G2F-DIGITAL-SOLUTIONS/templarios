---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';
import type { RouteKey } from '@/i18n/routes';

/**
 * LegalPage — shared renderer for the privacy, terms and cookies pages.
 * Content lives in the dictionaries, so every locale is complete.
 */
interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  paragraphs: string[];
}

const { locale, routeKey, title, description, paragraphs } = Astro.props;
const dict = getDictionary(locale);
const path = localizedPath(locale, routeKey);
const updated = '2026-10-21';
---

<BaseLayout locale={locale} {routeKey} title={title} description={description} path={path}>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={dict.footer.legalTitle}
    title={title}
    lead={description}
    crumbs={[{ label: title }]}
  />

  <Section>
    <div class="mx-auto max-w-2xl">
      <p class="flex items-center gap-2 text-sm text-stone-500">
        <Icon name="calendar" size={16} class="text-gold-600" />
        {dict.legal.updatedLabel}:
        <time datetime={updated}>{updated}</time>
      </p>

      <div class="prose-templar mt-8">
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <p class="mt-10 rounded-sm border-l-2 border-gold-500 bg-parchment-dark/40 px-4 py-3 text-sm text-ink-600">
        {dict.legal.reviewNote}
      </p>

      <a href={localizedPath(locale, 'participate')} class="btn btn-outline mt-8">
        {dict.nav.ctaSecondary}
      </a>
    </div>
  </Section>
</BaseLayout>
