---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';

/**
 * Dia das Cidades — a focused institutional page explaining the project and
 * routing interest to the contact form with a prefilled subject.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const page = dict.pages.citiesDay;
const content = dict.citiesDay;
const path = localizedPath(locale, 'citiesDay');

const blocks: { key: 'what' | 'purpose' | 'how' | 'why'; icon: 'compass' | 'shield' | 'scroll' | 'hand-heart' }[] = [
  { key: 'what', icon: 'compass' },
  { key: 'purpose', icon: 'shield' },
  { key: 'how', icon: 'scroll' },
  { key: 'why', icon: 'hand-heart' },
];
---

<BaseLayout
  locale={locale}
  routeKey="citiesDay"
  title={page.title}
  description={page.lead}
  path={path}
>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={page.kicker}
    title={page.title}
    lead={page.lead}
    crumbs={[{ label: page.title }]}
  />

  <Section>
    <ol class="grid gap-6 md:grid-cols-2">
      {
        blocks.map((block, index) => (
          <li class="card p-6 md:p-8">
            <div class="flex items-center gap-4">
              <span
                class="grid size-12 shrink-0 place-items-center rounded-sm border border-gold-500/40 text-gold-700"
                aria-hidden="true"
              >
                <Icon name={block.icon} size={24} />
              </span>
              <span class="font-display text-xs font-semibold tracking-[0.2em] text-stone-400 uppercase">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <h2 class="mt-5 !text-xl">{content[`${block.key}Title`]}</h2>
            <p class="mt-3 text-ink-600">{content[`${block.key}Text`]}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-14 frame-engraved overflow-hidden rounded-md surface-dark texture-stone">
      <div class="grid gap-8 p-8 md:p-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="!text-parchment">{content.bringTitle}</h2>
          <p class="mt-4 text-stone-200/90">{content.bringText}</p>
          <p class="mt-4 text-stone-200/80">{content.participateText}</p>
        </div>
        <div class="flex flex-col justify-center gap-3 lg:col-span-5">
          <a
            href={`${localizedPath(locale, 'contact')}?assunto=dia-das-cidades`}
            class="btn btn-gold w-full"
          >
            {content.cta}
            <Icon name="arrow-right" size={17} />
          </a>
          <a href={localizedPath(locale, 'events')} class="btn btn-ghost-light w-full">
            {dict.nav.events}
          </a>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>