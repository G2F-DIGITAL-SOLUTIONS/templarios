---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import InstitutionalSection from '@/components/InstitutionalSection.astro';
import Timeline from '@/components/Timeline.astro';
import Section from '@/components/ui/Section.astro';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';
import type { RouteKey } from '@/i18n/routes';
import type { Section as SectionContent } from '@/content/institution';

/**
 * InstitutionPage — shared renderer for the institutional pages
 * (Quem Somos, História, Propósitos, Ensinamentos). Page files stay thin.
 */
interface Props {
  locale: Locale;
  routeKey: RouteKey;
  kicker: string;
  title: string;
  lead: string;
  intro?: string;
  sections: SectionContent[];
  variant?: 'sections' | 'timeline';
}

const { locale, routeKey, kicker, title, lead, intro, sections, variant = 'sections' } = Astro.props;
const dict = getDictionary(locale);
const path = localizedPath(locale, routeKey);

/** Sibling institutional pages for the "continue exploring" links. */
const relatedLinks: { routeKey: RouteKey; label: string }[] = [
  { routeKey: 'order', label: dict.nav.about },
  { routeKey: 'history', label: dict.nav.history },
  { routeKey: 'purposes', label: dict.nav.purposes },
  { routeKey: 'teachings', label: dict.nav.teachings },
];
---

<BaseLayout locale={locale} routeKey={routeKey} title={title} description={lead} path={path}>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={kicker}
    title={title}
    lead={intro ?? lead}
    crumbs={[{ label: title }]}
  />

  <Section>
    {
      variant === 'timeline' ? (
        <Timeline entries={sections} locale={locale} />
      ) : (
        <div class="flex flex-col gap-14 md:gap-20">
          {sections.map((section, index) => (
            <InstitutionalSection section={section} locale={locale} reversed={index % 2 === 1} />
          ))}
        </div>
      )
    }
  </Section>

  <!-- Related links -->
  <Section tone="parchment" size="tight">
    <h2 class="!text-xl">{dict.sections.related}</h2>
    <p class="mt-2 text-ink-600">{dict.sections.relatedLead}</p>
    <ul class="mt-6 flex flex-wrap gap-3">
      {
        relatedLinks
          .filter((link) => link.routeKey !== routeKey)
          .map((link) => (
            <li>
              <a href={localizedPath(locale, link.routeKey)} class="btn btn-outline">
                {link.label}
              </a>
            </li>
          ))
      }
    </ul>
  </Section>
</BaseLayout>