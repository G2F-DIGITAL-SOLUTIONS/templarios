---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import EventCard from '@/components/EventCard.astro';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import { events } from '@/content/events';
import { tx } from '@/content/localize';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';
import { isUpcoming } from '@/utils/date';
import { site } from '@/config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const page = dict.pages.events;
const path = localizedPath(locale, 'events');

const upcoming = events.filter((e) => isUpcoming(e.date));
const past = events.filter((e) => !isUpcoming(e.date));
---

<BaseLayout locale={locale} routeKey="events" title={page.title} description={page.lead} path={path}>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={page.kicker}
    title={page.title}
    lead={page.lead}
    crumbs={[{ label: page.title }]}
  />

  <Section>
    <div class="flex flex-wrap items-start justify-between gap-6">
      <h2>{dict.events.upcomingTitle}</h2>
      {site.eventsPlatformUrl && (
        <a href={site.eventsPlatformUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          {dict.events.ctaPlatform}
          <Icon name="arrow-up-right" size={17} />
        </a>
      )}
    </div>

    {site.eventsPlatformUrl && <p class="mt-3 max-w-2xl text-sm text-stone-500">{dict.events.platformNote}</p>}

    {
      upcoming.length > 0 ? (
        <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {upcoming.map((event) => (
            <EventCard
              locale={locale}
              title={tx(event.title, locale)}
              summary={tx(event.summary, locale)}
              date={event.date}
              location={tx(event.location, locale)}
              url={event.url ?? (site.eventsPlatformUrl || undefined)}
              dateLabel={dict.home.events.dateLabel}
              locationLabel={dict.home.events.locationLabel}
              cta={dict.events.ctaPlatform}
            />
          ))}
        </ul>
      ) : (
        <p class="mt-8 text-ink-600">{dict.events.emptyState}</p>
      )
    }

    {
      past.length > 0 && (
        <div class="mt-16">
          <h2 class="!text-xl">{dict.events.pastTitle ?? dict.events.upcomingTitle}</h2>
          <ul class="mt-8 grid gap-5 opacity-80 md:grid-cols-2 lg:grid-cols-3">
            {past.map((event) => (
              <EventCard
                locale={locale}
                title={tx(event.title, locale)}
                summary={tx(event.summary, locale)}
                date={event.date}
                location={tx(event.location, locale)}
                dateLabel={dict.home.events.dateLabel}
                locationLabel={dict.home.events.locationLabel}
                cta={dict.events.ctaPlatform}
              />
            ))}
          </ul>
        </div>
      )
    }
  </Section>
</BaseLayout>