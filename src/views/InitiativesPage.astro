---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import InitiativeCard from '@/components/InitiativeCard.astro';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import { initiatives } from '@/content/initiatives';
import { tx } from '@/content/localize';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const page = dict.pages.initiatives;
const path = localizedPath(locale, 'initiatives');
---

<BaseLayout
  locale={locale}
  routeKey="initiatives"
  title={page.title}
  description={page.lead}
  path={path}
>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={page.kicker}
    title={page.title}
    lead={page.lead}
    crumbs={[{ label: page.title }]}
  />

  <Section>
    <p class="prose-templar !text-lg mx-auto text-center">
      {dict.home.initiatives.lead}
    </p>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        initiatives.map((initiative) => (
          <InitiativeCard
            locale={locale}
            title={tx(initiative.name, locale)}
            text={tx(initiative.description, locale)}
            icon={initiative.icon}
            routeKey={initiative.routeKey}
            cta={dict.home.initiatives.cardCta}
            image={
              ['environment', 'sport', 'health', 'education'].includes(initiative.id)
                ? `/img/iniciativas/${initiative.id}.svg`
                : undefined
            }
            imageAlt={tx(initiative.name, locale)}
          />
        ))
      }
    </ul>
  </Section>

  <Section tone="dark" size="tight">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="!text-parchment">{dict.home.donations.kicker}</h2>
      <p class="mt-4 text-stone-200/90">{dict.home.donations.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={localizedPath(locale, 'donations')} class="btn btn-gold w-full sm:w-auto">
          {dict.home.donations.ctaPrimary}
          <Icon name="arrow-right" size={17} />
        </a>
        <a href={localizedPath(locale, 'contact')} class="btn btn-ghost-light w-full sm:w-auto">
          {dict.home.finalCta.secondary}
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>