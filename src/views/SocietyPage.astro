---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import CTA from '@/components/ui/CTA.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const society = dict.society;
const page = dict.pages.society;
const path = localizedPath(locale, 'society');

const areaIcons: IconName[] = [
  'hand-heart',
  'graduation',
  'heart-pulse',
  'trophy',
  'leaf',
  'book',
  'scroll',
  'compass',
  'shield',
];
---

<BaseLayout
  locale={locale}
  routeKey="society"
  title={page.title}
  description={page.lead}
  path={path}
>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={page.kicker}
    title={page.title}
    lead={page.lead}
    crumbs={[{ label: page.title }]}
  />

  <Section size="tight">
    <p class="prose-templar mx-auto max-w-3xl !text-lg">{society.intro}</p>
  </Section>

  <!-- ABTL -->
  <Section id="abtl" tone="parchment">
    <span id="cultura" aria-hidden="true"></span>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <SectionHeading kicker={society.abtl.kicker} title={society.abtl.title} as="h2" />
        <div class="prose-templar mt-6">
          {society.abtl.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="card p-6">
          <h3 class="font-display text-base font-semibold text-ink-900">
            {society.abtl.areasTitle}
          </h3>
          <ul class="mt-4 flex flex-col gap-2.5">
            {
              society.abtl.areas.map((area) => (
                <li class="flex gap-2.5 text-sm text-ink-600">
                  <Icon name="check" size={16} class="mt-0.5 shrink-0 text-gold-600" />
                  <span>{area}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <!-- Damas Templárias -->
  <Section id="damas">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <SectionHeading kicker={society.ladies.kicker} title={society.ladies.title} as="h2" />
        <div class="prose-templar mt-6">
          {society.ladies.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="frame-engraved rounded-md bg-surface-raised p-6">
          <p class="eyebrow">{society.ladies.firstLadyLabel}</p>
          <p class="mt-3 font-display text-xl font-semibold text-ink-900">
            {society.ladies.firstLadyName}
          </p>
          <p class="mt-4 text-sm text-ink-600">{society.ladies.firstLadyNote}</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Áreas de atuação -->
  <Section id="areas-de-atuacao" tone="sunken">
    <span id="atuacao-social" aria-hidden="true"></span>
    <SectionHeading
      kicker={society.areas.kicker}
      title={society.areas.title}
      lead={society.areas.lead}
      align="center"
      class="mx-auto"
    />
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        society.areas.items.map((item, index) => (
          <li class="card flex h-full flex-col p-6">
            <span class="text-gold-600" aria-hidden="true">
              <Icon name={areaIcons[index] ?? 'compass'} size={24} />
            </span>
            <h3 class="mt-4 font-display text-base font-semibold text-ink-900">{item.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{item.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="mx-auto mt-8 max-w-3xl text-center text-xs text-stone-500">{society.areas.note}</p>
  </Section>

  <!-- Publicações -->
  <Section id="publicacoes" tone="parchment">
    <div class="mx-auto max-w-3xl">
      <SectionHeading kicker={society.publications.kicker} title={society.publications.title} as="h2" />
      <div class="prose-templar mt-6">
        {society.publications.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </Section>

  <CTA
    locale={locale}
    title={society.cta.title}
    lead={society.cta.lead}
    primaryLabel={society.cta.primary}
    primaryRouteKey="order"
    secondaryLabel={society.cta.secondary}
    secondaryRouteKey="participate"
    variant="quiet"
  />
</BaseLayout>
