---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactForm from '@/components/ContactForm.astro';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const page = dict.pages.contact;
const path = localizedPath(locale, 'contact');
---

<BaseLayout
  locale={locale}
  routeKey="contact"
  title={page.title}
  description={page.lead}
  path={path}
>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={page.kicker}
    title={page.title}
    lead={page.lead}
    crumbs={[{ label: page.title }]}
  />

  <Section>
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Info -->
      <div class="lg:col-span-5">
        <h2 class="!text-2xl">{dict.contact.infoTitle}</h2>
        <ul class="mt-6 flex flex-col gap-6">
          <li class="flex gap-4">
            <span class="mt-0.5 text-gold-600" aria-hidden="true">
              <Icon name="mail" size={22} />
            </span>
            <div>
              <h3 class="font-display text-base font-semibold text-ink-900">
                {dict.contact.emailLabel}
              </h3>
              <span class="mt-1 link-quiet inline-block break-all">{site.email}</span>
              <p class="mt-1 text-xs text-stone-500">
                {dict.contact.emailPending}
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="mt-0.5 text-gold-600" aria-hidden="true">
              <Icon name="globe" size={22} />
            </span>
            <div>
              <h3 class="font-display text-base font-semibold text-ink-900">
                Redes Sociais
              </h3>
              <span class="mt-1 link-quiet inline-block break-all">
                {site.socialHandle}
              </span>
              <p class="mt-1 text-xs text-stone-500">
                {site.socialPlatforms.join(' e ')} — {dict.contact.socialPending}
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="mt-0.5 text-gold-600" aria-hidden="true">
              <Icon name="calendar" size={22} />
            </span>
            <div>
              <h3 class="font-display text-base font-semibold text-ink-900">
                {dict.contact.hoursLabel}
              </h3>
              <p class="mt-1 text-ink-600">{dict.contact.hoursValue}</p>
            </div>
          </li>
        </ul>
        <p class="mt-6 text-xs text-stone-500">
          {dict.contact.addressPending}. {dict.contact.phonePending}
        </p>
      </div>

      <!-- Form -->
      <div class="lg:col-span-7">
        <h2 class="!text-2xl">{dict.contact.formTitle}</h2>
        <div class="mt-6">
          <ContactForm dict={dict} variant="contact" />
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>