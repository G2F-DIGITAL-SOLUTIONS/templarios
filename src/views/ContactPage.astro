---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactForm from '@/components/ContactForm.astro';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import { contactAddressLine, site } from '@/config/site';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const page = dict.pages.contact;
const path = localizedPath(locale, 'contact');
---

<BaseLayout
  locale={locale}
  routeKey="contact"
  title={page.title}
  description={page.lead}
  path={path}
>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={page.kicker}
    title={page.title}
    lead={page.lead}
    crumbs={[{ label: page.title }]}
  />

  <Section>
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Info -->
      <div class="lg:col-span-5">
        <h2 class="!text-2xl">{dict.contact.infoTitle}</h2>
        <ul class="mt-6 flex flex-col gap-6">
          {contactAddressLine && (
            <li class="flex gap-4">
              <span class="mt-0.5 text-gold-600" aria-hidden="true"><Icon name="map-pin" size={22} /></span>
              <div>
                <h3 class="font-display text-base font-semibold text-ink-900">{dict.contact.addressLabel}</h3>
                <address class="mt-1 not-italic text-ink-600">{contactAddressLine}</address>
              </div>
            </li>
          )}
          {site.phone && site.phoneHref && (
            <li class="flex gap-4">
              <span class="mt-0.5 text-gold-600" aria-hidden="true"><Icon name="phone" size={22} /></span>
              <div>
                <h3 class="font-display text-base font-semibold text-ink-900">{dict.contact.phoneLabel}</h3>
                <a href={site.phoneHref} class="link-quiet mt-1 inline-block">{site.phone}</a>
              </div>
            </li>
          )}
          <li class="flex gap-4">
            <span class="mt-0.5 text-gold-600" aria-hidden="true">
              <Icon name="mail" size={22} />
            </span>
            <div>
              <h3 class="font-display text-base font-semibold text-ink-900">
                {dict.contact.emailLabel}
              </h3>
              <a href={`mailto:${site.email}`} class="link-quiet mt-1 inline-block break-all">
                {site.email}
              </a>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="mt-0.5 text-gold-600" aria-hidden="true">
              <Icon name="calendar" size={22} />
            </span>
            <div>
              <h3 class="font-display text-base font-semibold text-ink-900">
                {dict.contact.hoursLabel}
              </h3>
              <p class="mt-1 text-ink-600">{dict.contact.hoursValue}</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Form -->
      <div class="lg:col-span-7">
        <h2 class="!text-2xl">{dict.contact.formTitle}</h2>
        <div class="mt-6">
          <ContactForm dict={dict} variant="contact" />
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>