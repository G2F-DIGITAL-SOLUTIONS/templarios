---
import CastleEntrance from '@/components/CastleEntrance.astro';
import CastleDoor from '@/components/CastleDoor.astro';
import Quote from '@/components/Quote.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import CTA from '@/components/ui/CTA.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';

import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);

const home = dict.home;
const path = localizedPath(locale, 'home');
const metaTitle = dict.meta.siteName;
const metaDescription = dict.meta.defaultDescription;

/** The four doors of the consolidated architecture. */
const doors: { key: keyof typeof home.doors.items; icon: IconName; featured?: boolean }[] = [
  { key: 'order', icon: 'scroll', featured: true },
  { key: 'heritage', icon: 'shield' },
  { key: 'society', icon: 'book' },
  { key: 'participate', icon: 'hand-heart' },
];

/** About highlights: title/text keys are paired, icons here. */
const aboutHighlights: { title: string; text: string; icon: IconName }[] = [
  { title: home.about.highlights.identity, text: home.about.highlights.identityText, icon: 'shield' },
  { title: home.about.highlights.origin, text: home.about.highlights.originText, icon: 'scroll' },
  { title: home.about.highlights.values, text: home.about.highlights.valuesText, icon: 'compass' },
  { title: home.about.highlights.today, text: home.about.highlights.todayText, icon: 'hand-heart' },
];

const societyIcons: IconName[] = ['book', 'heart-pulse', 'graduation', 'leaf'];
---

<BaseLayout
  locale={locale}
  routeKey="home"
  title={metaTitle}
  description={metaDescription}
  path={path}
>
  <!-- HERO -->
  <CastleEntrance locale={locale} dict={dict} />

  <!-- AS PORTAS -->
  <Section tone="parchment" id="portas">
    <SectionHeading
      kicker={home.doors.kicker}
      title={home.doors.title}
      lead={home.doors.lead}
      align="center"
      class="mx-auto"
      showSeal
    />
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        doors.map((door) => (
          <CastleDoor
            locale={locale}
            title={home.doors.items[door.key].label}
            text={home.doors.items[door.key].text}
            cta={home.doors.items[door.key].cta}
            icon={door.icon}
            routeKey={door.key}
            featured={door.featured}
          />
        ))
      }
    </ul>
  </Section>

  <!-- SOBRE A ORDEM -->
  <Section>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6">
        <SectionHeading
          kicker={home.about.kicker}
          title={home.about.title}
          lead={home.about.lead}
        />
        <p class="prose-templar mt-5">{home.about.body}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={localizedPath(locale, 'order')} class="btn btn-primary">
            {home.about.cta}
            <Icon name="arrow-right" size={17} />
          </a>
          <a href={localizedPath(locale, 'heritage')} class="btn btn-outline">
            {home.about.ctaSecondary}
          </a>
        </div>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-6">
        {
          aboutHighlights.map((item) => (
            <li class="card p-5">
              <span class="text-gold-600" aria-hidden="true">
                <Icon name={item.icon} size={22} />
              </span>
              <h3 class="mt-3 font-display text-base font-semibold text-ink-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- LEMA -->
  <Section tone="sunken" size="tight">
    <Quote text={home.motto.translation} source={home.motto.latin} />
  </Section>

  <!-- VALORES -->
  <Section id="valores">
    <SectionHeading
      kicker={home.values.kicker}
      title={home.values.title}
      lead={home.values.lead}
      align="center"
      class="mx-auto"
    />
    <ol class="mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
      {
        home.values.items.map((value, index) => (
          <li class="card flex flex-col items-center gap-2 px-3 py-5 text-center">
            <span class="font-display text-xs font-semibold tracking-widest text-gold-700" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="text-sm font-medium text-ink-800">{value}</span>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- INDEPENDÊNCIA -->
  <Section tone="dark" id="independencia">
    <div class="mx-auto max-w-3xl text-center">
      <SectionHeading
        kicker={home.independence.kicker}
        title={home.independence.title}
        align="center"
        tone="dark"
        class="items-center"
      />
      <p class="mt-6 text-stone-200/90">{home.independence.text}</p>
      <a
        href={`${localizedPath(locale, 'order')}#independencia`}
        class="btn btn-gold mt-8"
      >
        {home.independence.cta}
        <Icon name="arrow-right" size={17} />
      </a>
    </div>
  </Section>

  <!-- CULTURA E ATUAÇÃO SOCIAL -->
  <Section tone="parchment">
    <SectionHeading
      kicker={home.society.kicker}
      title={home.society.title}
      lead={home.society.lead}
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        home.society.items.map((item, index) => (
          <li class="card flex h-full flex-col p-6">
            <span class="text-gold-600" aria-hidden="true">
              <Icon name={societyIcons[index] ?? 'book'} size={24} />
            </span>
            <h3 class="mt-4 font-display text-base font-semibold text-ink-900">{item.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{item.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="mt-10 text-center">
      <a href={localizedPath(locale, 'society')} class="btn btn-outline">
        {home.society.cta}
        <Icon name="arrow-right" size={17} />
      </a>
    </div>
  </Section>

  <!-- CTA FINAL -->
  <CTA
    locale={locale}
    title={home.finalCta.title}
    lead={home.finalCta.lead}
    primaryLabel={home.finalCta.primary}
    primaryRouteKey="participate"
    secondaryLabel={home.finalCta.secondary}
    secondaryRouteKey="participate"
    variant="emphasis"
  />
</BaseLayout>
