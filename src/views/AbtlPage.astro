---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import { academy } from '@/content/institution';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';
import type { RouteKey } from '@/i18n/routes';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const dict = getDictionary(locale);
const page = dict.pages.abtl;
const path = localizedPath(locale, routeKey);
---

<BaseLayout
  locale={locale}
  routeKey={routeKey}
  title={page.title}
  description={page.lead}
  path={path}
>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={page.kicker}
    title={page.title}
    lead={page.lead}
    crumbs={[{ label: dict.nav.academy }]}
  />

  <Section>
    <div class="flex flex-col gap-14 md:gap-20">
      <section>
        <h2 class="!text-2xl md:!text-3xl">Áreas de Atuação</h2>
        <ul class="mt-6 space-y-4 prose-templar">
          {academy.areas.map((area) => (
            <li class="flex gap-3">
              <span class="shrink-0 text-gold-600" aria-hidden="true">
                •
              </span>
              <p>{area}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-8">
        <h2 class="!text-2xl md:!text-3xl">Relação com a OICMCTB</h2>
        <p class="prose-templar mt-4">{academy.relationship}</p>
      </section>

      <section class="mt-8">
        <h2 class="!text-2xl md:!text-3xl">Grafia Oficial</h2>
        <p class="prose-templar mt-4">{academy.noteOnSpelling}</p>
      </section>

      <section class="mt-8">
        <h2 class="!text-2xl md:!text-3xl">Escopo</h2>
        <p class="prose-templar mt-4">{academy.noInvention}</p>
      </section>
    </div>
  </Section>
</BaseLayout>