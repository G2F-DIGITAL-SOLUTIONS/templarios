---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import { ladies } from '@/content/institution';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';
import type { RouteKey } from '@/i18n/routes';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const dict = getDictionary(locale);
const page = dict.pages.damas;
const path = localizedPath(locale, routeKey);
---

<BaseLayout
  locale={locale}
  routeKey={routeKey}
  title={page.title}
  description={page.lead}
  path={path}
>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={page.kicker}
    title={page.title}
    lead={page.lead}
    crumbs={[{ label: dict.nav.templarLadies }]}
  />

  <Section>
    <div class="flex flex-col gap-14 md:gap-20">
      <section>
        <h2 class="!text-2xl md:!text-3xl">Primeira-Dama</h2>
        <p class="prose-templar mt-4">{ladies.firstLady}</p>
      </section>

      <section class="mt-8">
        <h2 class="!text-2xl md:!text-3xl">Nomenclatura Institucional</h2>
        <p class="prose-templar mt-4">{ladies.nomenclatureNote}</p>
      </section>

      <section class="mt-8">
        <h2 class="!text-2xl md:!text-3xl">Participação</h2>
        <p class="prose-templar mt-4">{ladies.participation}</p>
      </section>
    </div>
  </Section>
</BaseLayout>