---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import { getInitiative } from '@/content/initiatives';
import { tx } from '@/content/localize';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';
import type { RouteKey } from '@/i18n/routes';

interface Props {
  locale: Locale;
  initiativeId: string;
  routeKey: RouteKey;
}

const { locale, initiativeId, routeKey } = Astro.props;
const dict = getDictionary(locale);
const initiative = getInitiative(initiativeId);

if (!initiative) {
  throw new Error(`Unknown initiative: ${initiativeId}`);
}

const name = tx(initiative.name, locale);
const tagline = tx(initiative.tagline, locale);
const description = tx(initiative.description, locale);
const focus = tx(initiative.focus, locale);
const path = localizedPath(locale, routeKey);

const otherInitiatives = (['environment', 'sport', 'health', 'education'] as const).filter(
  (id) => id !== initiativeId,
);
---

<BaseLayout locale={locale} {routeKey} title={name} description={description} path={path}>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={dict.pages.initiatives.kicker}
    title={name}
    lead={tagline}
    crumbs={[
      { label: dict.pages.initiatives.title, routeKey: 'initiatives' },
      { label: name },
    ]}
  />

  <Section>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <div class="prose-templar">
          <p class="!text-lg">{description}</p>
        </div>

        <h2 class="mt-10 !text-2xl">{dict.home.initiatives.cardCta}</h2>
        <ul class="mt-5 flex flex-col gap-4">
          {
            focus.map((item) => (
              <li class="flex gap-3">
                <span class="mt-1 shrink-0 text-gold-600" aria-hidden="true">
                  <Icon name="check" size={19} />
                </span>
                <span class="text-ink-700">{item}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a href={localizedPath(locale, 'donations')} class="btn btn-primary">
            {dict.home.donations.ctaPrimary}
            <Icon name="arrow-right" size={17} />
          </a>
          <a href={localizedPath(locale, 'contact')} class="btn btn-outline">
            {dict.home.finalCta.secondary}
          </a>
        </div>
      </div>

      <div class="lg:col-span-4 lg:col-start-9">
        <div class="frame-engraved overflow-hidden rounded-md bg-ink-900">
          <img
            src={`/img/iniciativas/${initiative.id}.svg`}
            alt={name}
            width="720"
            height="540"
            class="aspect-4/3 size-full object-cover"
          />
        </div>

        <h2 class="mt-10 !text-lg">{dict.sections.related}</h2>
        <ul class="mt-4 flex flex-col gap-2">
          {
            otherInitiatives.map((id) => {
              const other = getInitiative(id)!;
              return (
                <li>
                  <a
                    href={localizedPath(locale, other.routeKey)}
                    class="flex items-center justify-between gap-3 rounded-sm border border-stone-200 bg-surface-raised px-4 py-3 text-sm no-underline transition-colors hover:border-gold-400 hover:text-wine-700"
                  >
                    {tx(other.name, locale)}
                    <Icon name="arrow-right" size={16} class="opacity-60" />
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </Section>
</BaseLayout>