---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import ImageLightbox from '@/components/ImageLightbox.astro';
import { teachingsSorted, formatTeachingDate } from '@/data/teachings';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const teachings = dict.teachings;
const page = dict.pages.teachings;
const path = localizedPath(locale, 'teachings');

const dateLocale =
  locale === 'pt' ? 'pt-BR' : locale === 'en' ? 'en-GB' : locale === 'es' ? 'es-ES' : locale;
---

<BaseLayout
  locale={locale}
  routeKey="teachings"
  title={page.title}
  description={page.lead}
  path={path}
>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={page.kicker}
    title={page.title}
    lead={page.lead}
    crumbs={[{ label: page.title }]}
  />

  <Section size="tight">
    <p class="prose-templar mx-auto max-w-3xl !text-lg">{teachings.intro}</p>
    {
      locale !== 'pt' && (
        <p class="mx-auto mt-4 max-w-3xl text-sm text-stone-500">{teachings.languageNote}</p>
      )
    }
  </Section>

  <Section tone="parchment" id="publicacoes">
    {
      teachingsSorted.length === 0 ? (
        <p class="text-center text-ink-600">{teachings.empty}</p>
      ) : (
        <ul class="mx-auto flex max-w-3xl flex-col gap-14">
          {teachingsSorted.map((post) => (
            <li class="border-b border-stone-300/60 pb-14 last:border-b-0 last:pb-0">
              <article>
                <time
                  datetime={post.date}
                  class="font-sans text-xs font-semibold tracking-[0.16em] text-gold-700 uppercase"
                >
                  {formatTeachingDate(post.date, dateLocale)}
                </time>
                <h2 class="mt-3 font-display text-2xl font-semibold text-ink-900 md:text-3xl">
                  {post.title}
                </h2>
                <p class="mt-3 text-base text-ink-600 italic">{post.summary}</p>
                <div class="prose-templar mt-6">
                  {post.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>

                {post.images.length > 0 && (
                  <ul
                    data-lightbox-gallery
                    class:list={[
                      'mt-8 grid gap-3',
                      post.images.length === 1
                        ? 'grid-cols-1'
                        : post.images.length === 2
                          ? 'grid-cols-1 sm:grid-cols-2'
                          : 'grid-cols-2 md:grid-cols-3',
                    ]}
                  >
                    {post.images.map((src, index) => {
                      const alt = `${post.title} - foto ${index + 1}`;
                      return (
                        <li
                          class:list={[
                            'overflow-hidden rounded-sm bg-stone-200/40',
                            post.images.length === 1 ? 'aspect-[4/3]' : 'aspect-square',
                          ]}
                        >
                          <button
                            type="button"
                            data-lightbox-trigger
                            data-src={src}
                            data-alt={alt}
                            class="group relative block h-full w-full cursor-zoom-in border-0 bg-transparent p-0"
                            aria-label={`${dict.a11y.expandImage}: ${alt}`}
                          >
                            <img
                              src={src}
                              alt={alt}
                              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                              loading="lazy"
                              decoding="async"
                            />
                          </button>
                        </li>
                      );
                    })}
                  </ul>
                )}

                {post.links && post.links.length > 0 && (
                  <ul class="mt-6 flex flex-col gap-2">
                    {post.links.map((link) => (
                      <li>
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 text-sm font-medium text-wine-700 no-underline hover:underline"
                        >
                          <Icon name="arrow-up-right" size={16} class="text-gold-600" />
                          {link.label}
                          <span class="sr-only"> ({teachings.externalLink})</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </Section>

  <ImageLightbox
    closeLabel={dict.a11y.closeLightbox}
    prevLabel={dict.a11y.prevImage}
    nextLabel={dict.a11y.nextImage}
    counterLabel={dict.a11y.imageCounter}
  />
</BaseLayout>
