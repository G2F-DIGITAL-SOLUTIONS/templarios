---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactForm from '@/components/ContactForm.astro';
import Section from '@/components/ui/Section.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';

/**
 * Afiliação — explains the Order first, then who may join, then the process,
 * and only then presents the form (per the brief's ordering).
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const page = dict.pages.affiliation;
const a = dict.affiliation;
const path = localizedPath(locale, 'affiliation');

const steps: { key: 'one' | 'two' | 'three' | 'four'; icon: IconName }[] = [
  { key: 'one', icon: 'book' },
  { key: 'two', icon: 'shield' },
  { key: 'three', icon: 'scroll' },
  { key: 'four', icon: 'hand-heart' },
];

const benefits: { key: keyof typeof a.benefits; icon: IconName }[] = [
  { key: 'study', icon: 'book' },
  { key: 'fraternity', icon: 'hand-heart' },
  { key: 'events', icon: 'calendar' },
  { key: 'growth', icon: 'graduation' },
];
---

<BaseLayout
  locale={locale}
  routeKey="affiliation"
  title={page.title}
  description={page.lead}
  path={path}
>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={page.kicker}
    title={page.title}
    lead={page.lead}
    crumbs={[{ label: page.title }]}
  />

  <!-- 1. Why -->
  <Section>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="!text-2xl">{a.purposeTitle}</h2>
        <p class="prose-templar mt-4">{a.purposeText}</p>

        <h2 class="mt-12 !text-2xl">{a.whoTitle}</h2>
        <p class="prose-templar mt-4">{a.whoText}</p>
      </div>


    </div>
  </Section>

  <!-- 2. Process -->
  <Section tone="parchment">
    <h2 class="!text-2xl">{a.processTitle}</h2>
    <ol class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, index) => (
          <li class="card p-6">
            <div class="flex items-center justify-between">
              <span
                class="grid size-11 place-items-center rounded-full border border-gold-500/40 text-gold-700"
                aria-hidden="true"
              >
                <Icon name={step.icon} size={21} />
              </span>
              <span class="font-display text-sm font-semibold tracking-widest text-stone-300">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <h3 class="mt-4 font-display text-base font-semibold text-ink-900">
              {a.steps[step.key].title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{a.steps[step.key].text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- 3. Benefits & responsibilities -->
  <Section>
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="!text-2xl">{a.benefitsTitle}</h2>
        <ul class="mt-6 flex flex-col gap-4">
          {
            benefits.map((benefit) => (
              <li class="flex gap-3">
                <span class="mt-0.5 shrink-0 text-gold-600" aria-hidden="true">
                  <Icon name={benefit.icon} size={20} />
                </span>
                <span class="text-ink-700">{a.benefits[benefit.key]}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="!text-2xl">{a.responsibilitiesTitle}</h2>
        <p class="prose-templar mt-4">{a.responsibilitiesText}</p>
      </div>
    </div>
  </Section>

  <!-- 4. Form -->
  <Section tone="sunken" id="formulario">
    <div class="mx-auto max-w-3xl">
      <h2 class="!text-2xl">{a.formTitle}</h2>
      <p class="mt-3 text-ink-600">{a.formIntro}</p>
      <div class="mt-8">
        <ContactForm dict={dict} variant="affiliation" />
      </div>
    </div>
  </Section>
</BaseLayout>