---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import AccordionItem from '@/components/ui/AccordionItem.astro';
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import { getDictionary } from '@/i18n/dictionaries';
import { localizedPath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const participate = dict.participate;
const page = dict.pages.participate;
const path = localizedPath(locale, 'participate');
---

<BaseLayout
  locale={locale}
  routeKey="participate"
  title={page.title}
  description={page.lead}
  path={path}
>
  <PageHero
    locale={locale}
    dict={dict}
    kicker={page.kicker}
    title={page.title}
    lead={page.lead}
    crumbs={[{ label: page.title }]}
  />

  <!-- Como participar -->
  <Section id="participar">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6">
        <SectionHeading
          kicker={participate.interest.kicker}
          title={participate.interest.title}
          as="h2"
        />
        <div class="prose-templar mt-6">
          {participate.interest.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="lg:col-span-6">
        <h3 class="font-display text-base font-semibold text-ink-900">
          {participate.interest.stepsTitle}
        </h3>
        <ol class="mt-4 flex flex-col gap-4">
          {
            participate.interest.steps.map((step, index) => (
              <li class="card flex gap-4 p-5">
                <span
                  class="grid size-9 shrink-0 place-items-center rounded-full border border-gold-500/50 font-display text-sm font-semibold text-gold-700"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <span>
                  <span class="block font-display text-base font-semibold text-ink-900">
                    {step.title}
                  </span>
                  <span class="mt-1 block text-sm text-ink-600">{step.text}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Section>

  <!-- Atividades e cerimônias -->
  <Section id="atividades" tone="sunken">
    <div class="mx-auto max-w-3xl">
      <SectionHeading
        kicker={participate.activities.kicker}
        title={participate.activities.title}
        as="h2"
      />
      <div class="prose-templar mt-6">
        {participate.activities.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </Section>

  <!-- Contribuições -->
  <Section id="contribuicoes" tone="parchment">
    <div class="mx-auto max-w-3xl">
      <SectionHeading
        kicker={participate.donations.kicker}
        title={participate.donations.title}
        as="h2"
      />
      <div class="prose-templar mt-6">
        {participate.donations.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="mt-6 rounded-sm border-l-2 border-gold-500 bg-parchment-dark/40 px-4 py-3 text-sm text-ink-600">
        {participate.donations.note}
      </p>
    </div>
  </Section>

  <!-- Contato -->
  <Section id="contato">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <SectionHeading
          kicker={participate.contact.kicker}
          title={participate.contact.title}
          as="h2"
        />
        <dl class="mt-8 flex flex-col gap-6">
          <div>
            <dt class="text-xs font-semibold tracking-[0.16em] text-stone-500 uppercase">
              {participate.contact.emailLabel}
            </dt>
            <dd class="mt-1.5">
              <a
                href={`mailto:${site.email}`}
                class="inline-flex items-center gap-2 text-base font-medium text-wine-700 no-underline hover:underline"
              >
                <Icon name="mail" size={18} class="text-gold-600" />
                {site.email}
              </a>
              <p class="mt-1 text-xs text-stone-500">{participate.contact.emailNote}</p>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-[0.16em] text-stone-500 uppercase">
              {participate.contact.socialLabel}
            </dt>
            <dd class="mt-1.5 flex items-center gap-2 text-base font-medium text-ink-800">
              <Icon name="globe" size={18} class="text-gold-600" />
              {participate.contact.socialHandle}
            </dd>
            <dd class="mt-1 text-xs text-stone-500">{participate.contact.platforms}</dd>
          </div>
        </dl>
        <p class="mt-6 text-sm text-stone-500">{participate.contact.note}</p>
      </div>

      <div class="lg:col-span-7">
        <h3 class="font-display text-xl font-semibold text-ink-900">
          {participate.contact.formTitle}
        </h3>
        <p class="mt-2 text-sm text-ink-600">{participate.contact.formIntro}</p>
        <div class="mt-6">
          <ContactForm dict={dict} />
        </div>
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section id="perguntas-frequentes" tone="parchment">
    <div class="mx-auto max-w-3xl">
      <SectionHeading
        kicker={participate.faq.kicker}
        title={participate.faq.title}
        lead={participate.faq.lead}
        align="center"
        class="mx-auto"
      />
      <div class="mt-8">
        {
          participate.faq.items.map((item, index) => (
            <AccordionItem
              question={item.q}
              answer={item.a}
              name="faq"
              id={`faq-${index + 1}`}
              open={index === 0}
            />
          ))
        }
      </div>
    </div>
  </Section>
</BaseLayout>
